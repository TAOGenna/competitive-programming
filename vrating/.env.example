# Copy to .env and fill in. .env is gitignored; this file is the documentation.
# Comments go on their own line; a '#' after a value is part of the value.
# A real environment variable always beats the file.

# Codeforces accounts, comma or space separated. Several are treated as one person:
# one career, one upsolve list, and a round sat on two of them counted once.
# Old handles are fine -- renames are resolved and duplicates collapse.
VRATING_HANDLES=

# AtCoder accounts. Same rules, separate namespace.
VRATING_AC_HANDLES=

# Everything below is optional; the defaults are what the app ships with.
# VRATING_PORT=8770
# VRATING_HOST=127.0.0.1
# VRATING_DATA=./data
# VRATING_WORKERS=4
# VRATING_PREWARM_WORKERS=4
# VRATING_MAX_SCANS=4
# VRATING_CACHED_CONTESTS=256
