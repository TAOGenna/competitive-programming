# /etc/systemd/system/vrating.service
#   systemctl enable --now vrating
[Unit]
Description=vrating
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vrating
WorkingDirectory=/srv/vrating
Environment=PYTHONPATH=/srv/vrating
Environment=VRATING_HOST=127.0.0.1
Environment=VRATING_PORT=8770
Environment=VRATING_DATA=/srv/vrating/data
# Concurrent replays share one Codeforces rate-limit budget; cap them.
Environment=VRATING_MAX_SCANS=4
Environment=VRATING_WORKERS=4
ExecStart=/usr/bin/python3 -m vrating.web.server
Restart=always
RestartSec=3

# Read-only service: it needs nothing outside its own cache.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/vrating/data

[Install]
WantedBy=multi-user.target
